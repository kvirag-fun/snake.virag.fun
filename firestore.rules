rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global leaderboard entries. One document per submitted run - no
    // login here (it's a public game, unlike the other virag.fun apps),
    // so the rule itself is the entire anti-cheat check: reads are public,
    // writes must look like a real run this game could actually produce.
    match /snakeScores/{entry} {
      allow read: if true;

      allow create:
        if request.resource.data.keys().hasOnly(['difficulty', 'score', 'nickname', 'ouroboros', 'jormungandr', 'basilisk', 'createdAt'])
        && request.resource.data.difficulty in ['0.00', '0.25', '0.50', '1.00']
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        // 20x20 board, +10 per food: the snake can reach at most 400
        // tiles from a start of 1, so at most 399 apples = 3990. On top
        // of that come the one-time easter-egg bonuses (see index.html),
        // all three of which a single run can collect since they fire in
        // a strict chain: Ouroboros (at most +400, scaled by the length
        // it was bitten at) -> Basilisk (+400 flat) -> Jörmungandr
        // (+1000). Theoretical ceiling: 3990 + 400 + 400 + 1000 = 5790.
        // Rounded up to 6000 for headroom - the point is to reject scores
        // no real run could produce, not to track the exact total, so
        // small bonus tweaks don't need a rule change.
        && request.resource.data.score <= 6000
        // Optional nickname, entered client-side when a run actually
        // qualifies for the top 5. This is a charset/length guard only -
        // profanity filtering happens client-side (see index.html) since
        // a rule can't practically match against a word list. Not a
        // security boundary, just keeps garbage out of the stored data.
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 15
        && request.resource.data.nickname.matches('^[A-Za-z0-9 _.-]*$')
        // Whether this run triggered the Ouroboros/Jörmungandr/Basilisk
        // easter eggs (index.html) - each shown as a small badge next to
        // the score.
        && request.resource.data.ouroboros is bool
        && request.resource.data.jormungandr is bool
        && request.resource.data.basilisk is bool
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
